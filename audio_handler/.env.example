N8N_WEBHOOK_API=https://your-n8n-domain/webhook-test/your-webhook-id
# Optional bearer token if webhook is protected
N8N_WEBHOOK_BEARER=
N8N_TIMEOUT_SECONDS=30
# n8n webhook payload limit is 16MB
MAX_PAYLOAD_BYTES=16777216
AUDIO_HANDLER_PORT=8091
N8N_BINARY_FIELD_NAME=audio
N8N_JWT_ENABLE=true
N8N_JWT_ALGORITHM=RS256
N8N_JWT_PRIVATE_KEY_PATH=/app/RS256_PEM_PRIVATE_KEY
N8N_JWT_KID=
N8N_JWT_ISS=audio_handler
N8N_JWT_SUB=audio_handler
N8N_JWT_AUD=
N8N_JWT_EXP_SECONDS=300
