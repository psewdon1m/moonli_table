# Ports
TABLE_GEN_API_PORT=8010
TABLE_GEN_FRONTEND_PORT=8080

# Local host paths
TABLE_GEN_DATA_HOST_PATH=./data
TABLE_GEN_COMFYUI_WORKFLOW_HOST_PATH=./ComfyUI_00050_2.json

# Orchestrator -> step services
TABLE_GEN_STEP_GENERATE_URL=http://step-generate:8001
TABLE_GEN_STEP_VECTORIZE_URL=http://step-vectorize:8002
TABLE_GEN_STEP_SEGMENT_URL=http://step-segment:8004
TABLE_GEN_STEP_PALETTE_URL=http://step-palette:8003
TABLE_GEN_STEP_HTTP_TIMEOUT_SECONDS=420

# Session generate backend selector: mock | comfyui | nano_banana_pro
TABLE_GEN_SESSION_GENERATE_BACKEND=nano_banana_pro
TABLE_GEN_DEFAULT_BACKEND=mock

# ComfyUI backend
TABLE_GEN_COMFYUI_BASE_URL=http://host.docker.internal:8000
TABLE_GEN_COMFYUI_WORKFLOW_PATH=/app/workflows/ComfyUI_00050_2.json
TABLE_GEN_COMFYUI_TIMEOUT_SECONDS=60
TABLE_GEN_COMFYUI_POLL_INTERVAL_SECONDS=1
TABLE_GEN_COMFYUI_POLL_MAX_ATTEMPTS=360
TABLE_GEN_COMFYUI_MAX_BATCH_SIZE=1

# Nano Banana Pro backend
TABLE_GEN_NANO_BANANA_PRO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
TABLE_GEN_NANO_BANANA_PRO_API_KEY=
TABLE_GEN_NANO_BANANA_PRO_TIMEOUT_SECONDS=90
TABLE_GEN_NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview
TABLE_GEN_NANO_BANANA_PRO_ASPECT_RATIO=1:1
TABLE_GEN_NANO_BANANA_PRO_IMAGE_SIZE=2K

